# Discord API - required to boot the bot. Everything else (roles, channels,
# ranks, infraction types, ticket categories) is now configured either in
# Discord itself with the /config command, or on the web dashboard below.
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_server_guild_id_here

# Database - required. This bot stores everything in Postgres, not a local
# file, since both the bot process and the web dashboard write to it, and
# because a local file does not survive a Render redeploy (the filesystem
# there is wiped on every deploy, restart, and free-plan spin-down).
#
# Use Neon or Supabase, NOT Render's own free Postgres offering: Render
# deletes a free Postgres database entirely after 30 days plus a 14-day
# grace period unless it is upgraded to a paid plan. Neon and Supabase's
# free tiers suspend an idle database instead of deleting it, and Neon in
# particular auto-resumes transparently on the next query with no manual
# step. Either one hands you a standard connection string, paste it below
# exactly as given, this app does not care which provider issued it.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Web dashboard - optional. Leave any of these unset and the dashboard just
# does not start (the bot itself still runs fine without it).
#
# DISCORD_CLIENT_SECRET: from the same Discord Developer Portal application
# as CLIENT_ID above (OAuth2 tab). Needed for the login flow's token
# exchange, separate from DISCORD_TOKEN which is the bot's own token.
#
# In the Discord Developer Portal, under OAuth2 -> Redirects, you must add
# exactly "<WEB_BASE_URL>/auth/callback" or login will fail. On Render this
# is "<your service's onrender.com URL>/auth/callback".
#
# WEB_BASE_URL must match what a browser actually loads this on, including
# scheme. Leave it unset on Render, RENDER_EXTERNAL_URL is detected
# automatically. Set it explicitly for any other host (a VPS, a tunnel for
# local OAuth testing, etc), using the public https URL, not localhost.
#
# SESSION_SECRET signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# On Render, render.yaml has Render generate and store this automatically.
DISCORD_CLIENT_SECRET=your_oauth2_client_secret_here
WEB_BASE_URL=http://localhost:3000
WEB_PORT=3000
SESSION_SECRET=generate_a_long_random_string_here

# PORT - do not set this yourself. Render injects it automatically and the
# app reads it directly; WEB_PORT above is only the fallback for non-Render
# hosts. Listed here only so its absence is not mistaken for an oversight.

# DISABLE_SELF_PING - optional, defaults to enabled on Render. The app
# pings its own public URL every 10 minutes to stop Render's free plan from
# spinning the whole process down after 15 minutes idle, which would also
# disconnect the Discord bot, not just the dashboard. Set to "true" once on
# a paid plan (no spin-down to begin with, so the ping is pointless traffic).
DISABLE_SELF_PING=false
